# ============================================================
#  AI 获客平台 — 环境变量配置
# ============================================================
#  1. 复制本文件为 .env : cp .env.example .env
#  2. 填入你的真实配置
#  3. 生产部署: docker compose up -d
#  4. 本地开发: python -m uvicorn src.core.app:app
# ============================================================

# ---------- DeepSeek API (必填) ----------
DEEPSEEK_API_KEY=sk-请替换为你的密钥
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 平台安全（生产环境建议设置） ----------
# 设置后访问平台需要输入用户名密码
# BASIC_USER=admin
# BASIC_PASSWORD=请设置强密码

# ---------- 平台（通常用默认值即可） ----------
# REDIS_URL=redis://localhost:6379/0
# PLATFORM_DATA_DIR=./var/platform
# APP_TITLE=外贸客户平台

# ---------- 客户评估 (customer_eval) ----------
# CUSTOMER_EVAL_MAX_UPLOAD_MB=32
# CUSTOMER_EVAL_MAX_ROWS=500

# ---------- 邮件发送 (Gmail SMTP 或 Gmail API) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=ABC Export Team
# SMTP_REPLY_TO=sales@example.com
# SMTP_USE_TLS=true
# SMTP_SEND_DELAY=45
# MAIL_MAX_PER_JOB=50
# MAIL_DAILY_LIMIT=50
# MAIL_DEFAULT_LANG=auto

# ---------- Gmail API OAuth（可选，比 SMTP 更稳定） ----------
# 详见 tools/setup_gmail_oauth.py
# 将 var/gmail_client_secret.json 和 var/gmail_token.json 挂载到容器

# ---------- 邮件追踪 ----------
# 公网域名（追踪像素需要外网可访问），不设置则使用 APP_PUBLIC_URL 或 localhost
# TRACKING_BASE_URL=https://你的域名.com

# ---------- 企业微信（询盘邮件 2.0 回信推送） ----------
# 收到客户回信后，通过企业微信应用消息推送给业务员
# 注册地址: https://work.weixin.qq.com/
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 平台公网地址（生成回信详情链接用）
PLATFORM_BASE_URL=http://localhost:8000

# ---------- IMAP 回信监控 ----------
# 轮询间隔（秒，默认 60）
IMAP_POLL_INTERVAL=60

# ---------- Docker 构建（可选） ----------
# PYTHON_IMAGE=python:3.12-slim-bookworm
# REDIS_IMAGE=redis:7-alpine
