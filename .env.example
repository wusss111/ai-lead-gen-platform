# 复制本文件为 .env（仓库根目录），填入真实密钥。
# .env 已在 .gitignore 中，勿提交到 Git。

# ---------- DeepSeek API ----------
DEEPSEEK_API_KEY=sk-请替换为你的密钥
# 可选：
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 平台配置 ----------
# REDIS_URL=redis://127.0.0.1:6379/0
# PLATFORM_DATA_DIR=./var/platform
# APP_TITLE=外贸客户平台
# 若设置以下两项则启用浏览器 Basic 登录
# BASIC_USER=internal
# BASIC_PASSWORD=请设置强密码

# ---------- Agent: 客户评估 ----------
# CUSTOMER_EVAL_MAX_UPLOAD_MB=32
# CUSTOMER_EVAL_MAX_ROWS=500
# CUSTOMER_EVAL_QUEUE=customer_eval:default

# ---------- Agent: CRM ----------
# CRM_PAGE_SIZE=20

# ---------- Agent: 询盘邮件 (SMTP) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-domain@example.com
# SMTP_FROM_NAME=ABC Export Team
# SMTP_REPLY_TO=sales@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_SEND_DELAY=45
# MAIL_MAX_PER_JOB=50
# MAIL_DAILY_LIMIT=50
# MAIL_DEFAULT_LANG=auto

# ---------- Docker (可选) ----------
# PYTHON_IMAGE=python:3.11-slim-bookworm
# REDIS_IMAGE=redis:7-alpine
